{
  "name": "@studio/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pipeline:fixture": "node --import tsx src/cli/run-fixture.ts",
    "llm:external": "node --import tsx src/llm/run-external-script-cli.ts",
    "queue:reconcile": "node --import tsx src/queue/start-worker.ts",
    "worker": "node --env-file-if-exists=../../.env --import tsx src/queue/run-worker.ts",
    "worker:llm": "node --env-file-if-exists=../../.env --import tsx src/queue/run-worker.ts --queues=llm",
    "worker:media": "node --env-file-if-exists=../../.env --import tsx src/queue/run-worker.ts --queues=media",
    "worker:render": "node --env-file-if-exists=../../.env --import tsx src/queue/run-worker.ts --queues=render",
    "demo:seed": "node --import tsx src/cli/seed-demo.ts seed",
    "demo:delete": "node --import tsx src/cli/seed-demo.ts delete"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@studio/config": "workspace:*",
    "@studio/contracts": "workspace:*",
    "@studio/db": "workspace:*",
    "@studio/video": "workspace:*",
    "bullmq": "^5.81.5",
    "redis": "^5.8.2",
    "remotion": "4.0.539",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
