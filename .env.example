# Sao chép thành .env và điền giá trị. Không commit .env.
# Node image cho container app: node:24

STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=

# Đường dẫn volume media local (relative hoặc absolute trên máy dev)
DATA_DIR=./data

# URL nội bộ service TTS (thêm ở P0-03)
TTS_BASE_URL=http://localhost:8000
