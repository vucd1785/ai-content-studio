# Sao chép thành .env và điền giá trị. Không commit .env.
# Node image cho container app: node:24

STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
# Model ID cho task script (mặc định gemini-3.6-flash nếu bỏ trống)
GEMINI_MODEL_SCRIPT=
# Model Director được chọn khi bắt đầu lượt chạy, phân cách bằng dấu phẩy (P3-12). Bỏ trống: chỉ model mặc định.
GEMINI_MODELS=
# thinkingConfig.thinkingLevel cho Gemini 3.x: minimal | low | medium | high (mặc định low)
GEMINI_THINKING_LEVEL_SCRIPT=low

# Claude Code CLI viết research và kịch bản bằng gói Claude của Director (ADR-007, bổ sung 2026-11-02).
# Model chọn theo run, phân cách bằng dấu phẩy: "claude-code" (model mặc định của tài khoản) hoặc "claude-code:<alias>".
# Bỏ trống: tắt. Cần cài Claude Code CLI và đăng nhập (`claude auth login`) trên máy chạy worker.
CLAUDE_CODE_MODELS=
# Đường dẫn file chạy CLI nếu `claude` không có trên PATH của worker
CLAUDE_BIN=
# Thời gian chờ tối đa mỗi lần gọi CLI (ms); bỏ trống: 600000
CLAUDE_CODE_TIMEOUT_MS=

# Đường dẫn volume media local (relative hoặc absolute trên máy dev)
DATA_DIR=./data

# URL nội bộ service TTS (thêm ở P0-03)
TTS_BASE_URL=http://localhost:8000
# Thời gian chờ TTS tối đa mỗi request (ms). Bỏ trống: không giới hạn (P3-17), lỗi thật vẫn báo ngay kèm chi tiết.
TTS_TIMEOUT_MS=

# Đăng YouTube bằng một nút (ADR-031). Tạo dự án Google Cloud, bật YouTube Data API v3, tạo OAuth client
# loại "Desktop app" rồi điền hai biến dưới. Bỏ trống: tắt tính năng đăng YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Khóa mã hóa refresh token, 32 byte base64. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_TOKEN_KEY=
# Bỏ trống: http://127.0.0.1:3001/api/youtube/oauth/callback
YOUTUBE_REDIRECT_URI=
